Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519

# --- Devbox (EC2 sa-east-1, conta Berzerk 908) -------------------------------
# Caminho 1: Tailscale (MagicDNS). Usa Tailscale SSH, não precisa de chave.
Host devbox
    HostName devbox
    User leonardoflores
    ServerAliveInterval 30

# Caminho 2: SSM, sem Tailscale e sem porta aberta. Resolve o instance id pelo
# tag Name, então não depende de IP. Precisa: aws cli + session-manager-plugin.
Host devbox-ssm
    User leonardoflores
    ProxyCommand sh -c "aws ssm start-session --region sa-east-1 --target $(aws ec2 describe-instances --region sa-east-1 --filters Name=tag:Name,Values=berzerk-devbox-prod Name=instance-state-name,Values=running --query 'Reservations[0].Instances[0].InstanceId' --output text) --document-name AWS-StartSSHSession --parameters portNumber=%p"
    ServerAliveInterval 30

