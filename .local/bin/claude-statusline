#!/usr/bin/env bash
# Statusline do Claude Code: modelo · contexto usado · repo (branch).
# Recebe JSON no stdin (model.display_name, context_window.used_percentage, cwd).
input=$(cat)
model=$(jq -r '.model.display_name // "?"' <<<"$input" | sed 's/^Claude //')
pct=$(jq -r '.context_window.used_percentage // empty' <<<"$input")
cwd=$(jq -r '.cwd // empty' <<<"$input")

# Catppuccin Mocha
mauve=$'\e[38;2;203;166;247m'; blue=$'\e[38;2;137;180;250m'; green=$'\e[38;2;166;227;161m'
yellow=$'\e[38;2;249;226;175m'; red=$'\e[38;2;243;139;168m'; dim=$'\e[38;2;108;112;134m'; reset=$'\e[0m'

# modelo: Fable em destaque (é o caro)
case "$model" in *Fable*) mcol=$mauve ;; *Opus*) mcol=$blue ;; *) mcol=$green ;; esac

ctx=""
if [ -n "$pct" ]; then
  p=${pct%.*}
  if   [ "$p" -ge 80 ]; then ccol=$red
  elif [ "$p" -ge 50 ]; then ccol=$yellow
  else ccol=$green; fi
  ctx="${dim} │ ${reset}ctx ${ccol}${p}%${reset}"
fi

repo=""
if [ -n "$cwd" ]; then
  name=$(basename "$cwd")
  branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
  repo="${dim} │ ${reset}${name}${branch:+ ${dim}(${branch})${reset}}"
fi

printf '%s%s%s%s%s\n' "$mcol" "$model" "$reset" "$ctx" "$repo"
