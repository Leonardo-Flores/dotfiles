#!/bin/bash
# Bluetooth menu using fuzzel.
#
# Design notes:
# - Singleton/toggle: a second click closes the open fuzzel menu instead
#   of stacking instances.
# - Scan is run synchronously (with a timeout) because there's no useful
#   cached device list to fall back on the way nmcli has one for Wi-Fi —
#   the user opted into "Scan for devices" knowing it takes a few seconds.

set -u

FUZZEL_COMMON=(--dmenu)

notify() { notify-send -t "${1:-2000}" "Bluetooth" "$2"; }

if pgrep -x fuzzel >/dev/null 2>&1; then
    pkill -x fuzzel
    exit 0
fi

power_status=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ {print $2}')

if [ "$power_status" = "no" ]; then
    chosen=$(printf "  Power On" | fuzzel "${FUZZEL_COMMON[@]}" \
        --lines 1 --prompt "Bluetooth off  ")
    if [[ "$chosen" == *"Power On"* ]]; then
        bluetoothctl power on >/dev/null
        sleep 1
        exec "$0"
    fi
    exit 0
fi

# --- Build paired-device list -------------------------------------------------
entries=()
macs=()
actions=()

while IFS= read -r line; do
    [ -z "$line" ] && continue
    mac=$(awk '{print $2}' <<<"$line")
    name=$(cut -d' ' -f3- <<<"$line")
    info=$(bluetoothctl info "$mac" 2>/dev/null)
    connected=$(awk '/Connected:/ {print $2}' <<<"$info")
    icon=$(awk '/Icon:/ {print $2}' <<<"$info")

    case "$icon" in
        audio-headset|audio-headphones) sym="" ;;
        input-keyboard)                 sym="" ;;
        input-mouse)                    sym="" ;;
        input-gaming)                   sym="" ;;
        phone)                          sym="" ;;
        computer)                       sym="" ;;
        *)                              sym="" ;;
    esac

    if [ "$connected" = "yes" ]; then
        entries+=("$sym  $name  (connected)")
        actions+=("disconnect")
    else
        entries+=("$sym  $name")
        actions+=("connect")
    fi
    macs+=("$mac")
done < <(bluetoothctl devices Paired 2>/dev/null)

menu=""
for e in "${entries[@]}"; do
    menu+="$e"$'\n'
done
menu+="  Scan for devices"$'\n'"  Power Off"

total_lines=$(( ${#entries[@]} + 2 ))
[ "$total_lines" -gt 10 ] && total_lines=10

chosen=$(printf '%s' "$menu" | fuzzel "${FUZZEL_COMMON[@]}" \
    --lines "$total_lines" --prompt "Bluetooth  ")
[ -z "$chosen" ] && exit 0

case "$chosen" in
    *"Scan for devices"*)
        notify 3000 "Scanning…"
        bluetoothctl --timeout 8 scan on >/dev/null 2>&1
        exec "$0"
        ;;
    *"Power Off"*)
        bluetoothctl power off >/dev/null
        notify 2000 "Bluetooth turned off"
        ;;
    *)
        for i in "${!entries[@]}"; do
            [ "${entries[$i]}" = "$chosen" ] || continue
            name=$(sed 's/^[^ ]*  //;s/  (connected)$//' <<<"$chosen")
            if [ "${actions[$i]}" = "disconnect" ]; then
                bluetoothctl disconnect "${macs[$i]}" >/dev/null
                notify 2000 "Disconnected from $name"
            else
                notify 2000 "Connecting to $name…"
                if bluetoothctl connect "${macs[$i]}" >/dev/null 2>&1; then
                    notify 3000 "Connected to $name"
                else
                    notify 4000 "Failed to connect to $name"
                fi
            fi
            break
        done
        ;;
esac
