#!/bin/bash
# Wi-Fi menu using wofi — scan, connect, disconnect.
#
# Design notes:
# - Toggle behavior: clicking the waybar icon while a wofi menu is already up
#   closes it (singleton). This avoids the "click 5 times because nothing
#   visibly happened, then mash Esc" failure mode.
# - Non-blocking rescan: `nmcli dev wifi list` *without* --rescan=no will
#   trigger a synchronous AP scan and block ~4 seconds — this was the actual
#   cause of the "menu doesn't open" feel. We pass --rescan=no to use the
#   cached list (returns in ~30ms) and trigger a background rescan to keep
#   the cache fresh for the *next* open.
# - Failure handling: if connecting to a saved network fails (wrong/changed
#   password), the broken profile is deleted and the user is reprompted.

set -u

WOFI_COMMON=(--dmenu -Dprint_command=false --cache-file /dev/null)

notify() { notify-send -t "${1:-2000}" "Wi-Fi" "$2"; }

# --- Singleton / toggle -------------------------------------------------------
# If any wofi menu is currently visible, treat this invocation as "close it".
# We match by exact process name so we don't accidentally kill unrelated stuff.
if pgrep -x wofi >/dev/null 2>&1; then
    pkill -x wofi
    exit 0
fi

# --- Wi-Fi off short-circuit --------------------------------------------------
if [ "$(nmcli radio wifi)" = "disabled" ]; then
    chosen=$(echo "  Turn Wi-Fi On" | wofi "${WOFI_COMMON[@]}" \
        --width 300 --height 55 --prompt "Wi-Fi Off")
    [[ "$chosen" == *"Turn Wi-Fi On"* ]] && nmcli radio wifi on
    exit 0
fi

# --- Build network list from cached scan --------------------------------------
# Kick off a fresh scan in the background so the *next* open is up to date.
# We do not wait for it — NetworkManager's cached list is good enough now.
nmcli dev wifi rescan >/dev/null 2>&1 &

current_ssid=$(nmcli -t -f active,ssid dev wifi | awk -F: '$1=="yes"{print substr($0, index($0,$2))}')

entries=()
ssids=()
declare -A seen

while IFS= read -r line; do
    # nmcli -t output is colon-separated and right-anchored: SSID:SIGNAL:SECURITY
    security="${line##*:}"
    rest="${line%:*}"
    signal="${rest##*:}"
    ssid="${rest%:*}"

    [ -z "$ssid" ] && continue
    [[ -n "${seen[$ssid]:-}" ]] && continue
    seen[$ssid]=1

    if   [ "$signal" -ge 75 ]; then icon="󰤨"
    elif [ "$signal" -ge 50 ]; then icon="󰤥"
    elif [ "$signal" -ge 25 ]; then icon="󰤢"
    else                            icon="󰤟"
    fi

    lock=""
    [[ -n "$security" ]] && lock="  "

    if [ "$ssid" = "$current_ssid" ]; then
        entries+=("$icon  $ssid$lock  (connected)")
    else
        entries+=("$icon  $ssid$lock  ${signal}%")
    fi
    ssids+=("$ssid")
done < <(nmcli -t -f ssid,signal,security dev wifi list --rescan no | sort -t: -k2 -nr)

menu=""
for e in "${entries[@]}"; do
    menu+="$e"$'\n'
done
menu+="  Turn Wi-Fi Off"

lines=$(( ${#entries[@]} + 1 ))
height=$(( lines * 36 + 20 ))
[ "$height" -gt 420 ] && height=420

chosen=$(printf '%s' "$menu" | wofi "${WOFI_COMMON[@]}" \
    --width 340 --height "$height" --prompt "Wi-Fi")
[ -z "$chosen" ] && exit 0

# --- Helpers for connect flow -------------------------------------------------
prompt_password() {
    wofi "${WOFI_COMMON[@]}" --width 340 --height 55 \
        --prompt "Password for $1" --password </dev/null
}

connect_with_password() {
    local ssid="$1"
    local password
    password=$(prompt_password "$ssid")
    [ -z "$password" ] && return 1

    notify 2000 "Connecting to $ssid…"
    if nmcli --wait 25 dev wifi connect "$ssid" password "$password" >/dev/null 2>&1; then
        notify 3000 "Connected to $ssid"
        return 0
    fi
    # Failed connect leaves a broken profile behind — drop it so retries work.
    nmcli con delete "$ssid" >/dev/null 2>&1
    notify 4000 "Failed to connect to $ssid (wrong password?)"
    return 1
}

# --- Act on choice ------------------------------------------------------------
case "$chosen" in
    *"Turn Wi-Fi Off"*)
        nmcli radio wifi off
        notify 2000 "Wi-Fi turned off"
        ;;
    *)
        for i in "${!entries[@]}"; do
            [ "${entries[$i]}" = "$chosen" ] || continue
            ssid="${ssids[$i]}"

            if [ "$ssid" = "$current_ssid" ]; then
                nmcli con down id "$ssid" >/dev/null 2>&1
                notify 2000 "Disconnected from $ssid"
                break
            fi

            if nmcli -t -f name con show | grep -qx "$ssid"; then
                # Saved profile exists — try it; on failure assume the saved
                # password is stale and reprompt.
                notify 2000 "Connecting to $ssid…"
                if nmcli --wait 25 con up id "$ssid" >/dev/null 2>&1; then
                    notify 3000 "Connected to $ssid"
                else
                    nmcli con delete "$ssid" >/dev/null 2>&1
                    connect_with_password "$ssid"
                fi
            else
                connect_with_password "$ssid"
            fi
            break
        done
        ;;
esac
