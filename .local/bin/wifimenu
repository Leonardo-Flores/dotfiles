#!/bin/bash
# Wi-Fi menu using fuzzel — scan, connect, disconnect.
#
# Design notes:
# - Launcher: fuzzel (Wayland-native, ~300ms cold-start vs wofi's ~500ms).
#   Theme lives in ~/.config/fuzzel/fuzzel.ini.
# - Toggle behavior: clicking the waybar icon while a fuzzel menu is up
#   closes it (singleton). Avoids the "click N times, mash Esc N times" loop.
# - Non-blocking rescan: `nmcli dev wifi list` *without* --rescan=no will
#   trigger a synchronous AP scan and block ~4s — this was the real cause
#   of "menu doesn't open". We pass --rescan=no to read the cached list
#   (~30ms) and kick off a background rescan to refresh for the *next* open.
# - Failure handling: if connecting to a saved network fails (wrong/changed
#   password), the broken profile is deleted and the user is reprompted.

set -u

FUZZEL_COMMON=(--dmenu)

notify() { notify-send -t "${1:-2000}" "Wi-Fi" "$2"; }

# --- Singleton / toggle -------------------------------------------------------
if pgrep -x fuzzel >/dev/null 2>&1; then
    pkill -x fuzzel
    exit 0
fi

# --- Wi-Fi off short-circuit --------------------------------------------------
if [ "$(nmcli radio wifi)" = "disabled" ]; then
    chosen=$(echo "  Turn Wi-Fi On" | fuzzel "${FUZZEL_COMMON[@]}" \
        --lines 1 --prompt "Wi-Fi off  ")
    [[ "$chosen" == *"Turn Wi-Fi On"* ]] && nmcli radio wifi on
    exit 0
fi

# --- Build network list from cached scan --------------------------------------
nmcli dev wifi rescan >/dev/null 2>&1 &

current_ssid=$(nmcli -t -f active,ssid dev wifi | awk -F: '$1=="yes"{print substr($0, index($0,$2))}')

entries=()
ssids=()
declare -A seen

while IFS= read -r line; do
    # nmcli -t output: SSID:SIGNAL:SECURITY (parse from right since SSIDs may contain colons)
    security="${line##*:}"
    rest="${line%:*}"
    signal="${rest##*:}"
    ssid="${rest%:*}"

    [ -z "$ssid" ] && continue
    [[ -n "${seen[$ssid]:-}" ]] && continue
    seen[$ssid]=1

    if   [ "$signal" -ge 75 ]; then icon="󰤨"
    elif [ "$signal" -ge 50 ]; then icon="󰤥"
    elif [ "$signal" -ge 25 ]; then icon="󰤢"
    else                            icon="󰤟"
    fi

    lock=""
    [[ -n "$security" ]] && lock="  "

    if [ "$ssid" = "$current_ssid" ]; then
        entries+=("$icon  $ssid$lock  (connected)")
    else
        entries+=("$icon  $ssid$lock  ${signal}%")
    fi
    ssids+=("$ssid")
done < <(nmcli -t -f ssid,signal,security dev wifi list --rescan no | sort -t: -k2 -nr)

menu=""
for e in "${entries[@]}"; do
    menu+="$e"$'\n'
done
menu+="  Turn Wi-Fi Off"

# Fuzzel sizes itself to --lines; cap so the menu doesn't fill the screen.
total_lines=$(( ${#entries[@]} + 1 ))
[ "$total_lines" -gt 12 ] && total_lines=12

chosen=$(printf '%s' "$menu" | fuzzel "${FUZZEL_COMMON[@]}" \
    --lines "$total_lines" --prompt "Wi-Fi  ")
[ -z "$chosen" ] && exit 0

# --- Helpers ------------------------------------------------------------------
prompt_password() {
    fuzzel "${FUZZEL_COMMON[@]}" --lines 0 --password='*' \
        --prompt "  $1  " </dev/null
}

connect_with_password() {
    local ssid="$1"
    local password
    password=$(prompt_password "$ssid")
    [ -z "$password" ] && return 1

    notify 2000 "Connecting to $ssid…"
    if nmcli --wait 25 dev wifi connect "$ssid" password "$password" >/dev/null 2>&1; then
        notify 3000 "Connected to $ssid"
        return 0
    fi
    # Drop the failed profile so retries get a fresh prompt instead of replaying the bad password.
    nmcli con delete "$ssid" >/dev/null 2>&1
    notify 4000 "Failed to connect to $ssid (wrong password?)"
    return 1
}

# --- Act on choice ------------------------------------------------------------
case "$chosen" in
    *"Turn Wi-Fi Off"*)
        nmcli radio wifi off
        notify 2000 "Wi-Fi turned off"
        ;;
    *)
        for i in "${!entries[@]}"; do
            [ "${entries[$i]}" = "$chosen" ] || continue
            ssid="${ssids[$i]}"

            if [ "$ssid" = "$current_ssid" ]; then
                nmcli con down id "$ssid" >/dev/null 2>&1
                notify 2000 "Disconnected from $ssid"
                break
            fi

            if nmcli -t -f name con show | grep -qx "$ssid"; then
                notify 2000 "Connecting to $ssid…"
                if nmcli --wait 25 con up id "$ssid" >/dev/null 2>&1; then
                    notify 3000 "Connected to $ssid"
                else
                    nmcli con delete "$ssid" >/dev/null 2>&1
                    connect_with_password "$ssid"
                fi
            else
                connect_with_password "$ssid"
            fi
            break
        done
        ;;
esac
